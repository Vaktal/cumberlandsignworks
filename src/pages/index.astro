---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import ProblemSection from '@components/ProblemSection.astro';
import GuideSection from '@components/GuideSection.astro';
import ThreeStepPlan from '@components/ThreeStepPlan.astro';
import ServicesStrip from '@components/ServicesStrip.astro';
import StakesSection from '@components/StakesSection.astro';
import SuccessSection from '@components/SuccessSection.astro';
import ProofWall from '@components/ProofWall.astro';
import RecentWork from '@components/RecentWork.astro';
import CTASection from '@components/CTASection.astro';
import MotionRuntime from '@components/motion/MotionRuntime.astro';
---

<BaseLayout
  title="Cumberland Signworks — Custom Signs, Shirts & Vehicle Wraps in Crossville, TN"
  description="Family-owned print shop in Crossville, TN since 2003. Signs, t-shirts, hats, banners, embroidery, and full vehicle wraps — all under one roof. Fast quotes, rush orders welcome."
>
  <Hero />
  <ProblemSection />
  <GuideSection />
  <ThreeStepPlan />
  <ServicesStrip />
  <StakesSection />
  <SuccessSection />
  <ProofWall />
  <RecentWork />
  <CTASection />

  <!-- Homepage-only immersive motion layer (showcase). Conversion pages stay lean. -->
  <MotionRuntime />
</BaseLayout>
