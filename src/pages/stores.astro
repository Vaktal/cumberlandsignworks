---
import BaseLayout from '@layouts/BaseLayout.astro';

const inkSoftUrl = import.meta.env.PUBLIC_INKSOFT_STORE_URL || null;

const useCases = [
  {
    title: 'School Fundraising Stores',
    body: 'Open a timed store for spirit wear, fundraising apparel, or class items. Parents order online — you collect zero money and chase zero sizes.',
  },
  {
    title: 'Team & League Uniform Portals',
    body: 'Players and families pick their sizes, add names and numbers, and pay directly. No more spreadsheets. No more collected envelopes.',
  },
  {
    title: 'Church & Org Stores',
    body: 'VBS shirts, mission trip apparel, staff polos, seasonal merch. Keep a permanent store open year-round or run a short-window campaign.',
  },
  {
    title: 'Business Staff Stores',
    body: 'Give your team a private portal to order their own branded gear — uniforms, jackets, polos — without routing every request through you.',
  },
  {
    title: 'Event Merchandise Shops',
    body: 'Running a tournament, festival, or reunion? Open a store before the event. Sell shirts, hats, and keepsakes without pre-buying inventory.',
  },
  {
    title: 'Retail Spirit Wear',
    body: 'Keep your community\'s identity visible year-round with a permanent spirit wear shop that handles fulfillment so you never have to.',
  },
];

const checklistItems = [
  'Fully branded storefront — your logo, colors, products',
  'Product customization tools — names, numbers, sizes',
  'Secure online checkout (credit/debit)',
  'Automatic order routing to our production queue',
  'Direct-to-door shipping or group pickup options',
  'Store open/close date control for time-limited runs',
  'Sales reporting available on request',
];
---

<BaseLayout
  title="Custom Online Stores — Fundraising & Team Apparel Shops | Cumberland Signworks"
  description="Cumberland Signworks builds and runs fully branded online stores for schools, teams, churches, and businesses across Crossville and the Upper Cumberland. Powered by InkSoft — no upfront cost to set up."
>
  <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
  <section class="section bg-cumberland-cream">
    <div class="container-rail max-w-4xl">
      <p class="eyebrow">Custom Online Stores</p>
      <h1 class="mt-4 text-cumberland-ink">
        Your own store.{' '}
        <span class="text-cumberland-forest">We build and run it.</span>
      </h1>
      <p class="mt-6 text-xl leading-relaxed text-cumberland-stone">
        Fundraising shops, spirit wear stores, team uniform portals. We set up a fully branded
        online storefront for your school, team, church, or business — so your people can order
        exactly what they need, when they need it, without chasing you for it.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/start-your-project" class="btn-primary">Set Up My Store</a>
        {inkSoftUrl && (
          <a
            href={inkSoftUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Browse Cumberland Signworks stores on InkSoft (opens in new tab)"
            class="btn-secondary"
          >
            Browse the store →
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ─── Use Cases ────────────────────────────────────────────────────── -->
  <section class="section bg-cumberland-mist/40">
    <div class="container-rail">
      <p class="eyebrow">Who it's for</p>
      <h2 class="mt-4 text-cumberland-ink">One store, any group.</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {useCases.map((item) => (
          <div class="rounded-3xl bg-white border border-cumberland-mist p-8">
            <span
              class="block h-3 w-3 rounded-full bg-cumberland-clay mb-5"
              aria-hidden="true"
            ></span>
            <p class="font-display text-2xl text-cumberland-ink leading-tight">{item.title}</p>
            <p class="mt-3 text-cumberland-stone text-sm">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── How It Works ─────────────────────────────────────────────────── -->
  <section class="section bg-cumberland-cream">
    <div class="container-rail">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-4 text-cumberland-ink">We handle the setup. You share the link.</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-3xl bg-cumberland-mist/40 border border-cumberland-mist p-8">
          <p class="font-display text-6xl text-cumberland-clay leading-none">1</p>
          <p class="mt-6 font-display text-2xl text-cumberland-ink leading-tight">
            Tell us about your store.
          </p>
          <p class="mt-3 text-cumberland-stone text-sm leading-relaxed">
            What products, which logos, what colors, what dates. If you don't have artwork yet,
            that's fine — we'll work through it together.
          </p>
        </div>
        <div class="rounded-3xl bg-cumberland-mist/40 border border-cumberland-mist p-8">
          <p class="font-display text-6xl text-cumberland-clay leading-none">2</p>
          <p class="mt-6 font-display text-2xl text-cumberland-ink leading-tight">
            We build and launch it.
          </p>
          <p class="mt-3 text-cumberland-stone text-sm leading-relaxed">
            Fully branded storefront on our platform — your logo, your colors, your URL. Usually
            live within a week.
          </p>
        </div>
        <div class="rounded-3xl bg-cumberland-mist/40 border border-cumberland-mist p-8">
          <p class="font-display text-6xl text-cumberland-clay leading-none">3</p>
          <p class="mt-6 font-display text-2xl text-cumberland-ink leading-tight">
            Your people order. We fulfill.
          </p>
          <p class="mt-3 text-cumberland-stone text-sm leading-relaxed">
            They shop, pay, and choose their size. We print and ship — directly to their door or
            to one pickup location. You're done once you share the link.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── What's Included ──────────────────────────────────────────────── -->
  <section class="section bg-cumberland-forest text-cumberland-cream">
    <div class="container-rail">
      <p class="eyebrow text-cumberland-stone">What's included</p>
      <h2 class="mt-4 text-cumberland-cream">Everything to run your store — we handle it.</h2>
      <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:items-start">
        <!-- Checklist -->
        <ul class="space-y-4">
          {checklistItems.map((item) => (
            <li class="flex gap-3 text-cumberland-mist text-sm leading-relaxed">
              <span
                class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-cumberland-mist/20 text-cumberland-mist text-xs font-bold"
                aria-hidden="true"
              >
                ✓
              </span>
              {item}
            </li>
          ))}
        </ul>
        <!-- Info cards -->
        <div class="flex flex-col gap-6">
          <div class="rounded-3xl bg-cumberland-forest-dark/60 p-8">
            <p class="font-display text-2xl text-cumberland-cream leading-tight">
              Powered by InkSoft
            </p>
            <p class="mt-3 text-cumberland-mist text-sm leading-relaxed">
              We use InkSoft — a purpose-built platform for decorated-apparel storefronts — so
              your store runs on proven, secure e-commerce infrastructure. Your customers get a
              clean shopping experience. We get automatic order routing straight into our
              production queue.
            </p>
          </div>
          <div class="rounded-3xl bg-cumberland-forest-dark/60 p-8">
            <p class="font-display text-2xl text-cumberland-cream leading-tight">
              No upfront cost to set up
            </p>
            <p class="mt-3 text-cumberland-mist text-sm leading-relaxed">
              There's no fee to open your store. You pay only for the items that are ordered and
              produced. Pricing is set when we scope the store together — so your group always
              knows what they're paying before the store goes live.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CTA ──────────────────────────────────────────────────────────── -->
  <section class="section bg-cumberland-cream">
    <div class="container-rail max-w-3xl text-center">
      <h2 class="text-cumberland-ink">Ready to set up your store?</h2>
      <p class="mt-4 text-lg text-cumberland-stone">
        Tell us about your group, what you need, and when — we'll build the rest.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/start-your-project" class="btn-primary">Set Up My Store</a>
        {inkSoftUrl && (
          <a
            href={inkSoftUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Browse Cumberland Signworks stores on InkSoft (opens in new tab)"
            class="btn-secondary"
          >
            Browse existing stores →
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
