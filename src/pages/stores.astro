---
import BaseLayout from '@layouts/BaseLayout.astro';
import CategoryHero from '@components/CategoryHero.astro';

const inkSoftUrl = import.meta.env.PUBLIC_INKSOFT_STORE_URL || null;

const useCases = [
  {
    title: 'School Fundraising Stores',
    body: 'Open a timed store for spirit wear, fundraising apparel, or class items. Parents order online — you collect zero money and chase zero sizes.',
  },
  {
    title: 'Team & League Uniform Portals',
    body: 'Players and families pick their sizes, add names and numbers, and pay directly. No more spreadsheets. No more collected envelopes.',
  },
  {
    title: 'Church & Org Stores',
    body: 'VBS shirts, mission trip apparel, staff polos, seasonal merch. Keep a permanent store open year-round or run a short-window campaign.',
  },
  {
    title: 'Business Staff Stores',
    body: 'Give your team a private portal to order their own branded gear — uniforms, jackets, polos — without routing every request through you.',
  },
  {
    title: 'Event Merchandise Shops',
    body: 'Running a tournament, festival, or reunion? Open a store before the event. Sell shirts, hats, and keepsakes without pre-buying inventory.',
  },
  {
    title: 'Retail Spirit Wear',
    body: 'Keep your community\'s identity visible year-round with a permanent spirit wear shop that handles fulfillment so you never have to.',
  },
];

const steps = [
  {
    title: 'Tell us about your store.',
    body: "What products, which logos, what colors, what dates. If you don't have artwork yet, that's fine — we'll work through it together.",
  },
  {
    title: 'We build and launch it.',
    body: 'Fully branded storefront on our platform — your logo, your colors, your URL. Usually live within a week.',
  },
  {
    title: 'Your people order. We fulfill.',
    body: "They shop, pay, and choose their size. We print and ship — directly to their door or to one pickup location. You're done once you share the link.",
  },
];

const checklistItems = [
  'Fully branded storefront — your logo, colors, products',
  'Product customization tools — names, numbers, sizes',
  'Secure online checkout (credit/debit)',
  'Automatic order routing to our production queue',
  'Direct-to-door shipping or group pickup options',
  'Store open/close date control for time-limited runs',
  'Sales reporting available on request',
];
---

<BaseLayout
  title="Custom Online Stores — Fundraising & Team Apparel Shops | Cumberland Signworks"
  description="Cumberland Signworks builds and runs fully branded online stores for schools, teams, churches, and businesses across Crossville and the Upper Cumberland. Powered by InkSoft — no upfront cost to set up."
>
  <CategoryHero
    label="Custom Online Stores"
    lead="Your own store."
    accent="We build and run it."
    sub="Fundraising shops, spirit wear stores, team uniform portals. We set up a fully branded online storefront for your school, team, church, or business — so your people can order exactly what they need, when they need it, without chasing you for it."
    primaryLabel="Set Up My Store"
  />

  <!-- ─── Who it's for ─────────────────────────────────────────────────── -->
  <section class="section bg-cumberland-paper">
    <div class="container-rail">
      <div class="border-t border-cumberland-ink/15 pt-6">
        <p class="rail-label text-cumberland-clay">Who it's for</p>
      </div>
      <h2 class="mt-8 max-w-4xl uppercase text-cumberland-ink" data-reveal>One store, any group.</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {
          useCases.map((item) => (
            <div class="rounded-[2px] border border-cumberland-ink/15 bg-cumberland-cream p-8">
              <span class="mb-5 block h-3 w-3 rounded-full bg-cumberland-clay" aria-hidden="true" />
              <p class="font-display text-2xl uppercase leading-tight tracking-tight text-cumberland-ink">
                {item.title}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-cumberland-stone">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─── How it works ─────────────────────────────────────────────────── -->
  <section class="section bg-cumberland-ink text-cumberland-cream">
    <div class="container-rail">
      <div class="border-t border-cumberland-hairline pt-6">
        <p class="rail-label text-cumberland-clay">How it works</p>
      </div>
      <h2 class="mt-8 max-w-4xl uppercase text-cumberland-cream" data-reveal>
        We handle the setup. You share the link.
      </h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3" data-reveal-stagger>
        {
          steps.map((step, i) => (
            <div class="border-t-2 border-cumberland-clay pt-6">
              <p class="font-display text-6xl leading-none text-cumberland-clay">
                {(i + 1).toString().padStart(2, '0')}
              </p>
              <p class="mt-6 font-display text-2xl uppercase leading-tight tracking-tight text-cumberland-cream">
                {step.title}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-cumberland-mist">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─── What's included ──────────────────────────────────────────────── -->
  <section class="section bg-cumberland-paper">
    <div class="container-rail">
      <div class="border-t border-cumberland-ink/15 pt-6">
        <p class="rail-label text-cumberland-clay">What's included</p>
      </div>
      <h2 class="mt-8 max-w-4xl uppercase text-cumberland-ink" data-reveal>
        Everything to run your store — we handle it.
      </h2>
      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:items-start">
        <ul class="space-y-4" data-reveal>
          {
            checklistItems.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed text-cumberland-ink">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-cumberland-clay text-xs font-bold text-cumberland-ink"
                  aria-hidden="true"
                >
                  ✓
                </span>
                {item}
              </li>
            ))
          }
        </ul>
        <div class="flex flex-col gap-6" data-reveal>
          <div class="rounded-[2px] border border-cumberland-ink/15 bg-cumberland-cream p-8">
            <p class="font-display text-2xl uppercase leading-tight tracking-tight text-cumberland-ink">
              Powered by InkSoft
            </p>
            <p class="mt-3 text-sm leading-relaxed text-cumberland-stone">
              We use InkSoft — a purpose-built platform for decorated-apparel storefronts — so your
              store runs on proven, secure e-commerce infrastructure. Your customers get a clean
              shopping experience. We get automatic order routing straight into our production queue.
            </p>
          </div>
          <div class="rounded-[2px] border border-cumberland-ink/15 bg-cumberland-cream p-8">
            <p class="font-display text-2xl uppercase leading-tight tracking-tight text-cumberland-ink">
              No upfront cost to set up
            </p>
            <p class="mt-3 text-sm leading-relaxed text-cumberland-stone">
              There's no fee to open your store. You pay only for the items that are ordered and
              produced. Pricing is set when we scope the store together — so your group always knows
              what they're paying before the store goes live.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CTA ──────────────────────────────────────────────────────────── -->
  <section class="section bg-cumberland-ink text-cumberland-cream">
    <div class="container-rail max-w-3xl text-center">
      <h2 class="uppercase text-cumberland-cream">Ready to set up your store?</h2>
      <p class="mt-4 text-lg text-cumberland-mist">
        Tell us about your group, what you need, and when — we'll build the rest.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-5 sm:flex-row">
        <a href="/start-your-project" class="btn-primary text-base md:text-lg">
          Set Up My Store
          <span aria-hidden="true">→</span>
        </a>
        {
          inkSoftUrl && (
            <a
              href={inkSoftUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Browse Cumberland Signworks stores on InkSoft (opens in new tab)"
              class="btn-ghost text-cumberland-cream"
            >
              Browse existing stores →
            </a>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
