---
import BaseLayout from '@layouts/BaseLayout.astro';
import CategoryHero from '@components/CategoryHero.astro';
import CTASection from '@components/CTASection.astro';
import ThreeStepPlan from '@components/ThreeStepPlan.astro';

// NOTE: there are no `category: print` service-detail pages yet (handoff §7.2),
// so these are static product types — a numbered list, not links to detail pages.
const products = [
  { name: 'Business Cards', description: 'Standard, rounded corner, thick stock. Design help included.' },
  { name: 'Flyers', description: 'Full-color 8.5×11, half-sheet, quarter-sheet. Events, menus, promos.' },
  { name: 'Door Hangers', description: 'Great for contractors, restaurants, and service businesses.' },
  { name: 'Rack Cards', description: '4×9 format for lobbies, waiting rooms, and countertops.' },
  { name: 'Postcards', description: 'Direct mail, announcements, and promotional mailers.' },
  { name: 'Brochures', description: 'Tri-fold and bi-fold. Help organizing content included.' },
];
---

<BaseLayout
  title="Business Cards & Print — Cumberland Signworks Crossville TN"
  description="Business cards, flyers, door hangers, and short-run printing in Crossville, TN. Design help included. Fast turnaround."
>
  <CategoryHero
    label="Business Cards & Print"
    lead="Printed materials that leave"
    accent="the right impression."
    sub="Cards, flyers, and door hangers — printed right here in Crossville, with design help built in. No guessing on file specs. No waiting on a call center."
  />

  <section class="section bg-cumberland-paper">
    <div class="container-rail">
      <div class="border-t border-cumberland-ink/15 pt-6">
        <p class="rail-label text-cumberland-clay">What we print</p>
      </div>

      <h2 class="mt-8 max-w-4xl uppercase text-cumberland-ink" data-reveal>Short-run print</h2>

      <ul class="mt-12 border-t border-cumberland-ink/15" data-reveal-stagger>
        {
          products.map((product, i) => (
            <li class="grid grid-cols-[auto_1fr] items-baseline gap-5 border-b border-cumberland-ink/15 py-6 md:gap-8 md:py-8">
              <span class="font-mono text-sm text-cumberland-stone">
                {(i + 1).toString().padStart(2, '0')}
              </span>
              <span class="min-w-0">
                <span class="block font-display text-2xl uppercase tracking-tight text-cumberland-ink md:text-4xl">
                  {product.name}
                </span>
                <span class="mt-1 block text-sm text-cumberland-stone">{product.description}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ThreeStepPlan />
  <CTASection />
</BaseLayout>
