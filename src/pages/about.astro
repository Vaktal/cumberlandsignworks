---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/CTASection.astro';

const stats = [
  { value: '23', label: 'Years in Crossville' },
  { value: '1,000+', label: 'Projects completed' },
  { value: '4.7★', label: 'Across 95+ reviews' },
  { value: '1', label: 'Shop. In-house. Done right.' },
];
---

<BaseLayout
  title="About Cumberland Signworks — Crossville, TN Since 2003"
  description="23 years in Crossville. In-house screen printing, embroidery, vehicle wraps, signs, and more. Family-owned. 4.7★ across 95+ reviews."
>
  <!-- Hero -->
  <section class="section bg-cumberland-cream">
    <div class="container-rail max-w-4xl">
      <p class="eyebrow">About us</p>
      <h1 class="mt-4 text-cumberland-ink">
        We help the Upper Cumberland show up looking like pros.
      </h1>
      <p class="mt-6 text-xl leading-relaxed text-cumberland-stone">
        Signs, shirts, hats, banners, and full vehicle wraps — designed and delivered fast,
        right here in Crossville. 23 years of in-house work. No outsourcing. No runaround.
      </p>
    </div>
  </section>

  <!-- Story + Stats -->
  <section class="section bg-white">
    <div class="container-rail">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div class="space-y-6 text-cumberland-stone leading-relaxed text-lg">
          <p>
            Cumberland Signworks opened in Crossville in 2003. Since then, the work hasn't changed much —
            help local schools, teams, churches, and business owners look their best. What has changed
            is the equipment. Screen printing, embroidery, vinyl, digital print, banners, vehicle wraps —
            all in-house, under one roof, by the same crew.
          </p>
          <p>
            That matters when you're on a deadline. When the shirts need to be ready by Friday and you
            can't afford a vendor who farms your order out to a warehouse three states away.
            Your order stays here. The people you're talking to are the people doing the work.
          </p>
          <p>
            Over 1,000 projects into this community — and counting. Game-day uniforms, grand-opening
            signs, wrapped work trucks, church event banners. If it carries a name, a logo, or a message
            here in the Upper Cumberland, there's a good chance we've had a hand in it.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-6">
          {stats.map((stat) => (
            <div class="rounded-3xl bg-cumberland-cream border border-cumberland-mist p-8 text-center">
              <p class="font-display text-4xl text-cumberland-forest leading-none">{stat.value}</p>
              <p class="mt-3 text-sm text-cumberland-stone leading-snug">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Team placeholder -->
  <section class="section bg-cumberland-mist/40">
    <div class="container-rail max-w-4xl">
      <p class="eyebrow">The team</p>
      <h2 class="mt-4 text-cumberland-ink">Real people. Same shop.</h2>
      <p class="mt-6 text-lg text-cumberland-stone leading-relaxed">
        When you call, a real person picks up. When you stop by, you're talking to the same people
        who'll be printing your shirts or cutting your decals. No ticket numbers. No call centers.
        Just the crew in the shop, answering your questions and getting your order right.
      </p>
      <!-- TODO: real team photos — photoshoot scheduled -->
      <div class="mt-10 rounded-3xl bg-cumberland-mist/60 border border-cumberland-mist p-16 text-center text-cumberland-stone text-sm">
        Team photos coming soon.
      </div>
    </div>
  </section>

  <!-- Community -->
  <section class="section bg-cumberland-forest text-cumberland-cream">
    <div class="container-rail max-w-3xl">
      <p class="eyebrow text-cumberland-mist">Why local matters</p>
      <h2 class="mt-4 text-cumberland-cream">
        We're not a warehouse. We're your neighbors.
      </h2>
      <p class="mt-6 text-lg text-cumberland-mist leading-relaxed">
        Online printers don't know your timeline. They don't know that the Homecoming game
        is Friday, or that your grand opening is Saturday, or that the church bus needs
        lettering before Sunday's trip.
      </p>
      <p class="mt-4 text-lg text-cumberland-mist leading-relaxed">
        We do. Because we live here too. Cumberland Signworks has been part of Crossville
        for 23 years — and every order we get right is one more reason this community
        trusts local over a search result.
      </p>
    </div>
  </section>

  <CTASection />
</BaseLayout>
