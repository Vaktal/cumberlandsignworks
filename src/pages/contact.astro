---
import BaseLayout from '@layouts/BaseLayout.astro';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE_DISPLAY || '(931) 707-0557';
const phoneTel = import.meta.env.PUBLIC_BUSINESS_PHONE || '+19317070557';
const email = import.meta.env.PUBLIC_BUSINESS_EMAIL || 'hello@cumberlandsignworks.com';
const address = import.meta.env.PUBLIC_BUSINESS_ADDRESS || '474 Hyder Ridge Rd, Crossville, TN 38555';
---

<BaseLayout
  title="Contact Cumberland Signworks — Crossville, TN"
  description="Visit, call, or message Cumberland Signworks — your local print shop in Crossville, Tennessee since 2003. Mon–Fri 9–4."
>
  <section class="section bg-cumberland-cream">
    <div class="container-rail max-w-4xl">
      <p class="eyebrow">We're easy to reach</p>
      <h1 class="mt-4 text-cumberland-ink">Real humans. Same shop. 23 years.</h1>

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <div class="rounded-3xl bg-white border border-cumberland-mist p-8">
          <h2 class="font-display text-2xl text-cumberland-ink">Stop by</h2>
          <p class="mt-3 text-cumberland-stone">{address}</p>
          <p class="mt-4 text-sm">
            <strong class="text-cumberland-ink">Hours:</strong>
            <br />
            Monday–Friday · 9:00 AM – 4:00 PM
          </p>
        </div>

        <div class="rounded-3xl bg-white border border-cumberland-mist p-8">
          <h2 class="font-display text-2xl text-cumberland-ink">Reach out</h2>
          <p class="mt-3">
            <a href={`tel:${phoneTel}`} class="text-cumberland-forest hover:underline font-semibold">
              {phone}
            </a>
          </p>
          <p class="mt-2">
            <a href={`mailto:${email}`} class="text-cumberland-forest hover:underline">
              {email}
            </a>
          </p>
          <a href="/start-your-project" class="btn-primary mt-6 inline-flex">Start Your Project</a>
        </div>
      </div>

      {/* TODO: replace src with real embed URL from maps.google.com — search "474 Hyder Ridge Rd, Crossville, TN 38555" → Share → Embed a map */}
      <div class="mt-12 aspect-video w-full rounded-3xl overflow-hidden border border-cumberland-mist">
        <iframe
          title="Cumberland Signworks location — 474 Hyder Ridge Rd, Crossville, TN"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3188.847!2d-85.02947!3d35.94854!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x885e79b5e1234567%3A0xabcdef!2s474+Hyder+Ridge+Rd%2C+Crossville%2C+TN+38555!5e0!3m2!1sen!2sus!4v1714200000000!5m2!1sen!2sus"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
