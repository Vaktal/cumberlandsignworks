---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import CategoryHero from '@components/CategoryHero.astro';
import ServiceIndex from '@components/ServiceIndex.astro';
import CTASection from '@components/CTASection.astro';
import ThreeStepPlan from '@components/ThreeStepPlan.astro';

const services = await getCollection('services', ({ data }) => data.category === 'vehicle-wraps');
services.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Vehicle Wraps & Lettering — Cumberland Signworks Crossville TN"
  description="Full vehicle wraps, partial wraps, fleet lettering, and single-door graphics in Crossville, TN. Installed in-house. Fast quotes."
>
  <CategoryHero
    label="Vehicle Wraps & Lettering"
    lead="Your truck is your best"
    accent="billboard."
    sub="Full wraps, partial wraps, fleet lettering, and single-door graphics — designed, printed, and installed in-house in Crossville, TN. Fast quotes. Rush orders welcome."
  />

  <ServiceIndex services={services} basePath="/vehicle-wraps" heading="Vehicle wrap services" />

  <ThreeStepPlan />
  <CTASection />
</BaseLayout>
