---
/**
 * GuideSection — empathy + authority. PEACE: E + A. Ink skin with the real shop photo.
 */
import { Image } from 'astro:assets';
import shopSnow from '../assets/photos/csw-shop-building-snow.jpg';

const proof = [
  { stat: '4.7★ · 95+ reviews', note: 'Known for fast turnaround, rush orders, and friendly handling.' },
  { stat: 'In-house everything', note: 'Screen print, embroidery, digital, vinyl, signage, full vehicle wraps.' },
  { stat: 'Locally owned · Crossville', note: 'Same family. Same shop. Same standards. 23 years.' },
];
---

<section class="section bg-cumberland-ink text-cumberland-cream">
  <div class="container-rail">
    <div class="border-t border-cumberland-hairline pt-6">
      <p class="rail-label text-cumberland-clay">02 — Your Guide</p>
    </div>

    <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6" data-reveal>
        <figure class="dot-resolve overflow-hidden rounded-[2px] border border-cumberland-hairline">
          <Image
            src={shopSnow}
            alt="The Cumberland Signworks shop — a red metal building lit up in the snow in Crossville, TN"
            width={1000}
            height={667}
            class="h-72 w-full object-cover md:h-[28rem]"
          />
          <figcaption
            class="bg-cumberland-forest-dark p-4 font-mono text-[11px] uppercase tracking-[0.12em] text-cumberland-stone"
          >
            The shop · 474 Hyder Ridge Rd · Crossville TN
          </figcaption>
        </figure>
      </div>

      <div class="lg:col-span-6">
        <h2 class="uppercase text-cumberland-cream" data-reveal>
          We've been the print shop for the Upper Cumberland for 23 years.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-cumberland-mist" data-reveal>
          We know what it's like when the season opener is Friday and the shirts haven't shipped,
          when the grand opening is in two weeks and there's still no sign on the building, when the
          church bus needs new lettering before the youth trip leaves.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-cumberland-mist" data-reveal>
          That's why every Cumberland Signworks order has a real human on it — from sketch to final
          delivery. No portals to fight. No call centers to escalate. Just a shop full of folks who
          do this every day and have done it more than 1,000 times in your community.
        </p>

        <dl class="mt-8 grid gap-px overflow-hidden rounded-[2px] border border-cumberland-hairline bg-cumberland-hairline" data-reveal-stagger>
          {
            proof.map((p) => (
              <div class="bg-cumberland-ink p-5">
                <dt class="font-display text-2xl uppercase tracking-tight text-cumberland-clay">
                  {p.stat}
                </dt>
                <dd class="mt-1 text-sm text-cumberland-mist">{p.note}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
