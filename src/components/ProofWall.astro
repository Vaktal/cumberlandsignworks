---
/**
 * ProofWall — testimonials. Pulls from content/testimonials.
 * v1: hardcoded sample. v2: getCollection('testimonials').
 */
import { getCollection } from 'astro:content';

let testimonials: { quote: string; name: string; role: string; service?: string }[] = [];
try {
  const entries = await getCollection('testimonials');
  testimonials = entries.flatMap((e) => e.data);
} catch {
  // Collection not yet populated — fall back to inline placeholders.
  testimonials = [
    {
      quote:
        'They turned a last-minute jersey order around in three days — saved our season.',
      name: 'Coach M.',
      role: 'Local Youth League',
    },
    {
      quote:
        'The truck wrap looks better than I imagined. People stop me at gas stations to ask about it.',
      name: 'Local HVAC Owner',
      role: 'Crossville, TN',
    },
    {
      quote:
        'Our VBS shirts have been with Cumberland for six years running. Why would we go anywhere else?',
      name: 'Crossville church group',
      role: 'Repeat customer',
    },
  ];
}
---

<section class="section bg-cumberland-mist/40">
  <div class="container-rail">
    <div class="max-w-3xl">
      <p class="eyebrow">From folks down the road</p>
      <h2 class="mt-4 text-cumberland-ink">Real reviews from real neighbors.</h2>
      <p class="mt-4 text-cumberland-stone">
        4.7 stars across 95+ reviews. Below are a few — pulled from Google,
        Facebook, and Birdeye.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        testimonials.slice(0, 3).map((t) => (
          <li class="rounded-3xl bg-white p-8 border border-cumberland-mist shadow-sm">
            <p class="text-cumberland-clay text-lg" aria-hidden="true">★★★★★</p>
            <blockquote class="mt-3 text-cumberland-ink leading-relaxed">
              "{t.quote}"
            </blockquote>
            <p class="mt-6 text-sm font-semibold text-cumberland-ink">{t.name}</p>
            <p class="text-sm text-cumberland-stone">{t.role}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
