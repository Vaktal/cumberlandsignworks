---
/**
 * ProofWall — testimonials. Pulls from content/testimonials.
 * v1: hardcoded sample. v2: getCollection('testimonials'). "Shop Floor" paper skin.
 */
import { getCollection } from 'astro:content';

let testimonials: { quote: string; name: string; role: string; service?: string }[] = [];
try {
  const entries = await getCollection('testimonials');
  testimonials = entries.flatMap((e) => e.data);
} catch {
  testimonials = [
    { quote: 'They turned a last-minute jersey order around in three days — saved our season.', name: 'Coach M.', role: 'Local Youth League' },
    { quote: 'The truck wrap looks better than I imagined. People stop me at gas stations to ask about it.', name: 'Local HVAC Owner', role: 'Crossville, TN' },
    { quote: 'Our VBS shirts have been with Cumberland for six years running. Why would we go anywhere else?', name: 'Crossville church group', role: 'Repeat customer' },
  ];
}
---

<section class="section bg-cumberland-paper">
  <div class="container-rail">
    <div class="border-t border-cumberland-ink/15 pt-6">
      <p class="rail-label text-cumberland-clay">07 — Proof</p>
    </div>

    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <h2 class="max-w-2xl uppercase text-cumberland-ink">Real reviews from real neighbors.</h2>
      <p class="font-mono text-sm uppercase tracking-[0.12em] text-cumberland-stone">
        <span class="text-cumberland-clay">4.7★</span> · 95+ reviews · Google / Facebook / Birdeye
      </p>
    </div>

    <ul class="mt-12 grid gap-px overflow-hidden border border-cumberland-ink/15 bg-cumberland-ink/15 md:grid-cols-3" data-reveal-stagger>
      {
        testimonials.slice(0, 3).map((t) => (
          <li class="flex flex-col bg-cumberland-paper p-8">
            <p class="text-lg text-cumberland-clay" aria-hidden="true">
              ★★★★★
            </p>
            <blockquote class="mt-4 flex-1 text-lg leading-relaxed text-cumberland-ink">
              "{t.quote}"
            </blockquote>
            <footer class="mt-6 border-t border-cumberland-ink/10 pt-4 font-mono text-xs uppercase tracking-[0.1em]">
              <span class="block font-bold text-cumberland-ink">{t.name}</span>
              <span class="text-cumberland-stone">{t.role}</span>
            </footer>
          </li>
        ))
      }
    </ul>
  </div>
</section>
