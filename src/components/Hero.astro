---
/**
 * Hero — "The Shop Floor" immersive opener.
 * Ink canvas + animated halftone, kinetic headline, magnetic CTA, real shop photo,
 * scroll-reactive service marquee. StoryBrand copy preserved verbatim.
 */
import { Image } from 'astro:assets';
import HalftoneCanvas from './motion/HalftoneCanvas.astro';
import trailer from '../assets/photos/vehicle-trailer-decals.jpg';

const services = [
  'Signs',
  'Vehicle Wraps',
  'Apparel',
  'Embroidery',
  'Banners',
  'Window Graphics',
  'Laser Engraving',
  'Merch Stores',
];
---

<section class="relative overflow-hidden bg-cumberland-ink text-cumberland-cream">
  <HalftoneCanvas class="opacity-50" />

  <!-- faint grid rail, paper-ledger feel -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.15]"
    style="background-image:linear-gradient(#2A2A2A 1px,transparent 1px);background-size:100% 6.5rem;"
    aria-hidden="true"
  >
  </div>

  <div class="container-rail relative z-10 pt-28 pb-0 md:pt-36 lg:pt-40">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow flex items-center gap-3">
          <span class="relative flex h-2.5 w-2.5">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cumberland-clay opacity-75"
            ></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-cumberland-clay"></span>
          </span>
          Crossville, TN · since 2003
        </p>

        <h1 class="kinetic mt-6 uppercase text-cumberland-cream">
          <span class="line"><span>Make your team,</span></span>
          <span class="line"><span>church, or business</span></span>
          <span class="line"><span class="text-cumberland-clay">look like pros.</span></span>
        </h1>

        <p
          class="mt-7 max-w-prose text-lg leading-relaxed text-cumberland-mist md:text-xl"
          data-reveal
        >
          Signs, shirts, hats, banners, and vehicle wraps — designed and delivered fast in
          Crossville, TN. 23 years. 1,000+ projects. One shop that actually picks up the phone.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-5" data-reveal>
          <a
            href="/start-your-project"
            data-magnetic
            data-cursor="START"
            class="btn-primary text-base md:text-lg"
          >
            Start Your Project
            <span aria-hidden="true">→</span>
          </a>
          <a href="/portfolio" class="btn-ghost text-cumberland-cream" data-cursor="VIEW"
            >See the work</a
          >
        </div>

        <ul
          class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 font-mono text-xs uppercase tracking-[0.12em] text-cumberland-stone"
          data-reveal
        >
          <li>
            <span class="text-cumberland-clay">★</span>
            <b class="text-cumberland-cream">4.7</b> / 95+ reviews
          </li>
          <li><b class="text-cumberland-cream">In-house</b> everything</li>
          <li><b class="text-cumberland-cream">23 years</b> locally owned</li>
          <li><b class="text-cumberland-cream">24–48hr</b> quotes</li>
        </ul>
      </div>

      <!-- Real shop photo: customer + their wrapped trailer, shop in the background -->
      <div class="lg:col-span-5" data-reveal>
        <figure
          class="dot-resolve relative overflow-hidden rounded-[2px] border border-cumberland-hairline"
        >
          <Image
            src={trailer}
            alt="A happy Cumberland Signworks customer in front of their custom-wrapped Little Friends Play trailer, outside the shop in Crossville, TN"
            width={900}
            height={600}
            class="h-72 w-full object-cover md:h-[26rem]"
            loading="eager"
          />
          <figcaption
            class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-cumberland-ink/90 to-transparent p-4 font-mono text-[11px] uppercase tracking-[0.12em] text-cumberland-mist"
          >
            Little Friends Play · trailer wrap · Crossville TN
          </figcaption>
        </figure>
      </div>
    </div>
  </div>

  <!-- Service marquee -->
  <div
    class="marquee relative z-10 mt-16 border-y border-cumberland-hairline bg-cumberland-ink/40 py-5"
    aria-hidden="true"
  >
    <div class="marquee-track" data-base="38">
      {
        [0, 1].map(() => (
          <>
            {services.map((s) => (
              <>
                <span class="px-7 font-display text-3xl uppercase tracking-wide md:text-4xl">
                  {s}
                </span>
                <span class="text-cumberland-clay">●</span>
              </>
            ))}
          </>
        ))
      }
    </div>
  </div>
</section>
