---
/**
 * Hero — homepage opener. Customer-as-hero promise + dual CTA.
 */
---

<section class="relative overflow-hidden bg-cumberland-cream">
  <div class="container-rail py-20 md:py-28 lg:py-36 grid gap-10 lg:gap-16 lg:grid-cols-12 items-center">
    <div class="lg:col-span-7">
      <p class="eyebrow">Crossville, TN · since 2003</p>
      <h1 class="mt-4 text-cumberland-ink">
        Make your team, church, or business
        <span class="text-cumberland-forest">look like pros.</span>
      </h1>
      <p class="mt-6 text-lg md:text-xl leading-relaxed max-w-prose text-cumberland-stone">
        Signs, shirts, hats, banners, and vehicle wraps — designed and delivered
        fast in Crossville, TN. 23 years. 1,000+ projects. One shop that
        actually picks up the phone.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/start-your-project" class="btn-primary text-base md:text-lg">
          Start Your Project
        </a>
        <a href="/portfolio" class="btn-ghost">See what we make →</a>
      </div>
      <ul class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-cumberland-stone">
        <li class="flex items-center gap-2">
          <span aria-hidden="true">★</span>
          4.7 stars · 95+ reviews
        </li>
        <li class="flex items-center gap-2">
          <span aria-hidden="true">🛠</span>
          In-house everything
        </li>
        <li class="flex items-center gap-2">
          <span aria-hidden="true">🏠</span>
          Locally owned, 23 years
        </li>
      </ul>
      <div class="mt-8 pt-8 border-t border-cumberland-mist grid gap-3 sm:grid-cols-2 text-sm">
        <a href="/start-your-project" class="flex items-start gap-3 hover:text-cumberland-forest group">
          <div>
            <p class="font-semibold text-cumberland-ink group-hover:text-cumberland-forest">Get a quote</p>
            <p class="text-cumberland-stone">Signs, shirts, wraps, and print — tell us what you need.</p>
          </div>
        </a>
        <a href="/stores" class="flex items-start gap-3 hover:text-cumberland-forest group">
          <div>
            <p class="font-semibold text-cumberland-ink group-hover:text-cumberland-forest">Get a group store</p>
            <p class="text-cumberland-stone">Fundraising, spirit wear, team portals — we build it.</p>
          </div>
        </a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <!-- TODO: real photo. Direction: split frame — youth team in matching shirts (left) + wrapped service truck on Crossville job site (right). No stock. -->
      <div
        class="aspect-[4/5] w-full rounded-3xl bg-gradient-to-br from-cumberland-forest via-cumberland-forest-dark to-cumberland-ink p-8 text-cumberland-cream flex flex-col justify-end shadow-2xl"
        role="img"
        aria-label="Photo placeholder — team uniforms and wrapped service truck"
      >
        <p class="font-display text-4xl tracking-tighter leading-none">
          One shop.<br />Everything printed,<br />stitched, wrapped,<br />or hung.
        </p>
      </div>
    </div>
  </div>
</section>
