---
/**
 * ServicesStrip — six service tiles. Each links to its pillar page.
 */
const services = [
  {
    title: 'Custom T-Shirts & Apparel',
    body: 'Screen print, DTG, embroidery, hats, polos, hoodies.',
    href: '/apparel',
  },
  {
    title: 'Team & League Uniforms',
    body: 'Bulk pricing, roster numbering, fast turns.',
    href: '/apparel/team-uniforms',
  },
  {
    title: 'Signs & Banners',
    body: 'Yard signs, aluminum, vinyl, real estate, event banners.',
    href: '/signs',
  },
  {
    title: 'Storefront & Window Graphics',
    body: 'Channel-style lettering, window vinyl, hours decals.',
    href: '/signs/storefront',
  },
  {
    title: 'Vehicle Wraps & Lettering',
    body: 'Full wraps, partial wraps, fleet, single-door.',
    href: '/vehicle-wraps',
  },
  {
    title: 'Business Cards & Print',
    body: 'Short-run, full-color, design help included.',
    href: '/print',
  },
];
---

<section class="section bg-cumberland-mist/40">
  <div class="container-rail">
    <div class="max-w-3xl">
      <p class="eyebrow">All under one roof</p>
      <h2 class="mt-4 text-cumberland-ink">
        One shop. Everything you need printed, stitched, wrapped, or hung.
      </h2>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <li>
            <a
              href={service.href}
              class="group block h-full rounded-3xl bg-white p-8 transition-all hover:-translate-y-1 hover:shadow-xl border border-cumberland-mist"
            >
              <p class="font-display text-2xl text-cumberland-ink leading-tight group-hover:text-cumberland-forest">
                {service.title}
              </p>
              <p class="mt-3 text-cumberland-stone">{service.body}</p>
              <p class="mt-6 text-sm font-semibold text-cumberland-clay">
                Learn more →
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
