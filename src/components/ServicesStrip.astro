---
/**
 * ServicesStrip — the "one shop" index. "Shop Floor" skin: editorial numbered list
 * on ink, each row sweeps orange on hover. Each links to its pillar page.
 */
const services = [
  { title: 'Custom T-Shirts & Apparel', body: 'Screen print, DTG, embroidery, hats, polos, hoodies.', href: '/apparel' },
  { title: 'Team & League Uniforms', body: 'Bulk pricing, roster numbering, fast turns.', href: '/apparel/team-uniforms' },
  { title: 'Signs & Banners', body: 'Yard signs, aluminum, vinyl, real estate, event banners.', href: '/signs' },
  { title: 'Storefront & Window Graphics', body: 'Channel-style lettering, window vinyl, hours decals.', href: '/signs/storefront' },
  { title: 'Vehicle Wraps & Lettering', body: 'Full wraps, partial wraps, fleet, single-door.', href: '/vehicle-wraps' },
  { title: 'Business Cards & Print', body: 'Short-run, full-color, design help included.', href: '/print' },
  { title: 'Custom Online Stores', body: 'Fundraising, spirit, and team stores — we set up and run a fully branded store for your group.', href: '/stores' },
];
---

<section class="section bg-cumberland-ink text-cumberland-cream">
  <div class="container-rail">
    <div class="border-t border-cumberland-hairline pt-6">
      <p class="rail-label text-cumberland-clay">04 — What We Make</p>
    </div>

    <h2 class="mt-8 max-w-4xl uppercase text-cumberland-cream" data-reveal>
      One shop. Everything you need printed, stitched, wrapped, or hung.
    </h2>

    <ul class="mt-12 border-t border-cumberland-hairline" data-reveal-stagger>
      {
        services.map((service, i) => (
          <li>
            <a
              href={service.href}
              data-cursor="OPEN"
              class="group grid grid-cols-[auto_1fr_auto] items-center gap-5 border-b border-cumberland-hairline py-6 transition-colors duration-300 hover:bg-cumberland-clay md:gap-8 md:py-8"
            >
              <span class="font-mono text-sm text-cumberland-stone transition-colors group-hover:text-cumberland-ink">
                0{i + 1}
              </span>
              <span class="min-w-0">
                <span class="block font-display text-2xl uppercase tracking-tight text-cumberland-cream transition-colors group-hover:text-cumberland-ink md:text-4xl">
                  {service.title}
                </span>
                <span class="mt-1 block text-sm text-cumberland-stone transition-colors group-hover:text-cumberland-ink/80">
                  {service.body}
                </span>
              </span>
              <span class="font-display text-2xl text-cumberland-clay transition-all duration-300 group-hover:translate-x-1 group-hover:text-cumberland-ink md:text-3xl" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
