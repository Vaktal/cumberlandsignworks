---
/**
 * ServicePageLayout — shared "Shop Floor" shell for every service detail page.
 *
 * Frames the service MDX (which carries its own hook + narrative) in editorial
 * ink/paper styling and adds the conversion furniture. The hero service title
 * carries a `transition:name=svc-title-<slug>` morph anchor that matches the
 * ServiceIndex row on the category page, so the card morphs into the hero on
 * navigation (handoff §3.3/§5). The title is a styled <p>, NOT an <h1> — the
 * MDX hook stays the page's single semantic <h1>.
 *
 * Conversion (lean) tier: reveals + dot-resolve hero only. NO MotionRuntime,
 * NO halftone here — keep LCP fast (§2).
 *
 * Props:
 *   title     — service title (hero + breadcrumb + <title>); morph anchor text
 *   summary   — meta description + hero sub
 *   category  — 'apparel' | 'signs' | 'vehicle-wraps' | 'print'
 *   slug      — service slug; drives the morph anchor name (required)
 *   bullets   — optional "What's included" list
 *   heroImage — optional hero photo (dot-resolve); morphs via svc-img-<slug>
 *   class     — extra classes merged onto the prose <article>
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/CTASection.astro';

interface Props {
  title: string;
  summary: string;
  category: string;
  slug: string;
  bullets?: string[];
  heroImage?: ImageMetadata;
  class?: string;
}

const {
  title,
  summary,
  category,
  slug,
  bullets = [],
  heroImage,
  class: className = '',
} = Astro.props;

const categoryLabels: Record<string, string> = {
  apparel: 'Apparel & Embroidery',
  signs: 'Signs & Banners',
  'vehicle-wraps': 'Vehicle Wraps',
  print: 'Business Print',
};

const categoryHref: Record<string, string> = {
  apparel: '/apparel',
  signs: '/signs',
  'vehicle-wraps': '/vehicle-wraps',
  print: '/print',
};

const categoryLabel = categoryLabels[category] ?? category;
const catHref = categoryHref[category] ?? `/${category}`;

// Mini-proof: pick a category-relevant testimonial, fall back to the first.
const proofByCategory: Record<string, string | undefined> = {
  apparel: 'Apparel',
  signs: 'Banners',
  'vehicle-wraps': 'Vehicle wrap',
};
const testimonialSets = await getCollection('testimonials');
const allTestimonials = testimonialSets.flatMap((t) => t.data);
const proof =
  allTestimonials.find((t) => t.service === proofByCategory[category]) ??
  allTestimonials[0] ??
  null;
---

<BaseLayout title={`${title} — Cumberland Signworks`} description={summary}>
  <!-- ─── Hero (paper) — morph target ──────────────────────────────────── -->
  <section class="bg-cumberland-paper pt-28 pb-16 md:pt-32 md:pb-20">
    <div class="container-rail">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-cumberland-stone">
          <li><a href="/" class="transition-colors hover:text-cumberland-clay">Home</a></li>
          <li aria-hidden="true" class="select-none">/</li>
          <li>
            <a href={catHref} class="transition-colors hover:text-cumberland-clay">{categoryLabel}</a>
          </li>
          <li aria-hidden="true" class="select-none">/</li>
          <li class="text-cumberland-ink" aria-current="page">{title}</li>
        </ol>
      </nav>

      <div class="mt-10 grid items-end gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p
            transition:name={`svc-title-${slug}`}
            class="font-display text-5xl uppercase leading-[0.95] tracking-tighter text-cumberland-ink md:text-7xl"
          >
            {title}
          </p>
          <p
            class="mt-6 max-w-prose text-lg leading-relaxed text-cumberland-stone md:text-xl"
            data-reveal
          >
            {summary}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-5" data-reveal>
            <a href="/start-your-project" class="btn-primary text-base md:text-lg">
              Start Your Project
              <span aria-hidden="true">→</span>
            </a>
            <a href={catHref} class="btn-ghost">All {categoryLabel}</a>
          </div>
        </div>

        {
          heroImage && (
            <div class="lg:col-span-5" data-reveal>
              <figure class="dot-resolve relative overflow-hidden rounded-[2px] border border-cumberland-ink/15">
                <Image
                  src={heroImage}
                  alt={`Cumberland Signworks ${title.toLowerCase()} work in Crossville, TN`}
                  width={900}
                  height={600}
                  class="h-72 w-full object-cover md:h-[24rem]"
                  loading="eager"
                  transition:name={`svc-img-${slug}`}
                />
              </figure>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ─── What's included ──────────────────────────────────────────────── -->
  {
    bullets.length > 0 && (
      <section class="section bg-cumberland-cream">
        <div class="container-rail">
          <div class="border-t border-cumberland-ink/15 pt-6">
            <p class="rail-label text-cumberland-clay">What's included</p>
          </div>
          <ul class="mt-10 grid gap-x-12 sm:grid-cols-2" data-reveal-stagger>
            {bullets.map((bullet, i) => (
              <li class="flex gap-5 border-b border-cumberland-ink/10 py-5">
                <span class="font-mono text-sm font-bold text-cumberland-clay">
                  {(i + 1).toString().padStart(2, '0')}
                </span>
                <span class="text-lg leading-snug text-cumberland-ink">{bullet}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ─── MDX narrative ────────────────────────────────────────────────── -->
  <article class:list={['section bg-cumberland-paper', className]}>
    <div class="container-rail">
      <div
        class="prose prose-lg mx-auto max-w-3xl
          prose-headings:font-display prose-headings:tracking-tight prose-headings:text-cumberland-ink
          prose-h1:text-4xl prose-h1:leading-[0.95] md:prose-h1:text-5xl
          prose-p:text-cumberland-stone prose-li:text-cumberland-stone prose-li:marker:text-cumberland-clay
          prose-strong:text-cumberland-ink
          prose-a:font-semibold prose-a:text-cumberland-clay prose-a:no-underline hover:prose-a:underline"
      >
        <slot />
      </div>
    </div>
  </article>

  <!-- ─── Mini proof (ink) ─────────────────────────────────────────────── -->
  {
    proof && (
      <section class="section bg-cumberland-ink text-cumberland-cream">
        <div class="container-rail max-w-4xl">
          <div class="border-t border-cumberland-hairline pt-6">
            <p class="rail-label text-cumberland-clay">Proof</p>
          </div>
          <blockquote class="mt-8" data-reveal>
            <p class="font-display text-3xl uppercase leading-tight tracking-tight text-cumberland-cream md:text-5xl">
              “{proof.quote}”
            </p>
            <footer class="mt-6 font-mono text-xs uppercase tracking-[0.16em] text-cumberland-stone">
              {proof.name} · {proof.role}
              {proof.rating ? ` · ${'★'.repeat(proof.rating)}` : ''}
            </footer>
          </blockquote>
        </div>
      </section>
    )
  }

  <CTASection />
</BaseLayout>
