---
/**
 * StakesSection — what they lose by going elsewhere. SB7: Failure. Paper skin, restrained.
 */
const risks = [
  "Game day with shirts that didn't ship.",
  'A storefront sign that blends into every other strip mall.',
  'A wrapped vehicle in the wrong shade of your brand color.',
  'A church youth event without the t-shirts the kids were promised.',
  'The exact same money — for noticeably worse work.',
];
---

<section class="section bg-cumberland-paper">
  <div class="container-rail">
    <div class="border-t border-cumberland-ink/15 pt-6">
      <p class="rail-label text-cumberland-clay">05 — The Stakes</p>
    </div>

    <h2 class="mt-8 max-w-3xl uppercase text-cumberland-ink" data-reveal>
      Same money. Worse work. Worse week.
    </h2>

    <ul class="mt-10 max-w-3xl" data-reveal-stagger>
      {
        risks.map((r) => (
          <li class="flex items-start gap-4 border-b border-cumberland-ink/10 py-4 text-lg text-cumberland-ink">
            <span class="mt-1 font-mono text-cumberland-stone" aria-hidden="true">
              ✕
            </span>
            <span>{r}</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 max-w-3xl text-xl leading-relaxed text-cumberland-stone" data-reveal>
      Your team, your business, your church deserves better than a tracking number from a stranger.
    </p>
  </div>
</section>
