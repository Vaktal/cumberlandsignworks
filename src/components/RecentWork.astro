---
/**
 * RecentWork — portfolio teaser. "Shop Floor" skin: duotone→color hover,
 * dot-resolve on enter, custom-cursor "VIEW" label. Real captioned shop shots.
 */
import { Image } from 'astro:assets';
import churchSign from '../assets/instagram/post-3-church-sign.jpg';
import shopShirt from '../assets/instagram/post-1-shirts-hats-signs.jpg';
import tommysHats from '../assets/photos/tommys-motorsports-hats-pair.jpg';
import selkSign from '../assets/photos/selk-pressure-washing-sign.jpg';
import ahRobertsDoors from '../assets/photos/ah-roberts-doors-decals.jpg';

const work = [
  { src: churchSign, alt: 'Cumberland Fellowship church sign installed by Cumberland Signworks in Crossville, TN', title: 'Cumberland Fellowship', meta: 'Monument sign · Crossville TN' },
  { src: shopShirt, alt: 'Homestead Elementary Field Day 2026 screen-printed shirts, fresh off the press at Cumberland Signworks', title: 'Homestead Elementary', meta: 'Screen printing · Rush order' },
  { src: tommysHats, alt: 'Tommy\'s Motorsports Crossville embroidered trucker hats made by Cumberland Signworks', title: "Tommy's Motorsports", meta: 'Embroidery · Crossville TN' },
  { src: selkSign, alt: 'Selk Pressure Washing & Roof Cleaning outdoor business sign made by Cumberland Signworks', title: 'Selk Pressure Washing', meta: 'Signage · Upper Cumberland' },
  { src: ahRobertsDoors, alt: 'A.H. Roberts Elementary School front doors with custom window decals installed by Cumberland Signworks', title: 'A.H. Roberts Elementary', meta: 'Window graphics · Crossville TN' },
];
---

<section class="section bg-cumberland-paper">
  <div class="container-rail">
    <div class="border-t border-cumberland-ink/15 pt-6">
      <p class="rail-label text-cumberland-clay">08 — Recent Work</p>
    </div>

    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <h2 class="uppercase text-cumberland-ink">What we've been making.</h2>
      <a
        href="https://www.instagram.com/cumberland.signworks/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost text-cumberland-ink"
        aria-label="Follow Cumberland Signworks on Instagram (opens in new tab)"
      >
        @cumberland.signworks →
      </a>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        work.map((w) => (
          <figure class="dot-resolve duotone group relative overflow-hidden rounded-[2px] border border-cumberland-ink/15">
            <div class="overflow-hidden">
              <Image
                src={w.src}
                alt={w.alt}
                width={600}
                height={600}
                data-cursor="VIEW"
                class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-cumberland-ink/90 to-transparent p-5">
              <p class="font-display text-xl uppercase tracking-tight text-cumberland-cream">
                {w.title}
              </p>
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-cumberland-mist">
                {w.meta}
              </p>
            </figcaption>
          </figure>
        ))
      }

      <!-- CTA tile -->
      <div class="flex flex-col justify-between rounded-[2px] bg-cumberland-ink p-8 text-cumberland-cream">
        <p class="font-display text-3xl uppercase leading-none tracking-tight">
          Signs. Shirts.<br />Wraps. Hats.<br /><span class="text-cumberland-clay">One roof.</span>
        </p>
        <a
          href="/start-your-project"
          data-magnetic
          data-cursor="START"
          class="btn-primary mt-6 self-start"
        >
          Start Your Project <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
