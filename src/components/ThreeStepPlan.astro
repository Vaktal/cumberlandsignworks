---
/**
 * ThreeStepPlan — the SB7 plan. Same 3 steps everywhere on the site.
 */
const steps = [
  {
    n: '1',
    title: 'Tell us what you need.',
    body:
      'Call, message, or fill the project form. Don\'t have artwork? No problem — we\'ll help you figure it out.',
  },
  {
    n: '2',
    title: 'We design and quote — fast.',
    body:
      'Free proof. Honest timeline. Clear price. Usually within 24–48 hours.',
  },
  {
    n: '3',
    title: 'You get it on time, looking right.',
    body:
      'Delivered to your school, your shop, your jobsite — or installed in person if it\'s a wrap or a sign.',
  },
];
---

<section class="section bg-cumberland-cream">
  <div class="container-rail">
    <div class="max-w-3xl">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-4 text-cumberland-ink">Working with us is simple.</h2>
    </div>

    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {
        steps.map((step) => (
          <li class="rounded-3xl border-2 border-cumberland-mist bg-white p-8">
            <p class="font-display text-6xl text-cumberland-clay leading-none">{step.n}</p>
            <p class="mt-4 font-display text-2xl text-cumberland-ink leading-tight">
              {step.title}
            </p>
            <p class="mt-3 text-cumberland-stone leading-relaxed">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 flex justify-center">
      <a href="/start-your-project" class="btn-primary text-base md:text-lg">
        Start Your Project
      </a>
    </div>
  </div>
</section>
