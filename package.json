{
  "name": "cumberland-signworks",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Cumberland Signworks — marketing site (Astro + Tailwind + MDX + Decap CMS).",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,md,mdx,json,css}\"",
    "typecheck": "astro check",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "11",
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/tailwind": "^5.1.3",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/bebas-neue": "^5.2.7",
    "@tailwindcss/typography": "^0.5.15",
    "astro": "^4.16.13",
    "astro-seo": "^0.8.4",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "wrangler": "^4.86.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
